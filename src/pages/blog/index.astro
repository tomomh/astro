---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { client, queries } from '../../lib/sanity';

const posts = await client.fetch(queries.allPosts);
---

<BaseLayout title="Blog | Astro + Sanity Demo" description="Read our latest blog posts">
  <section class="blog-header">
    <div class="container">
      <h1>Blog</h1>
      <p>Latest articles and updates</p>
    </div>
  </section>

  <section class="blog-posts">
    <div class="container">
      {posts.length === 0 ? (
        <p class="no-posts">No posts yet. Add some content in Sanity Studio!</p>
      ) : (
        <div class="posts-grid">
          {posts.map((post: any) => (
            <PostCard post={post} />
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-header {
    background: #1a1a2e;
    color: #fff;
    padding: 4rem 0;
    text-align: center;
  }

  .blog-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .blog-header p {
    color: #e0e0e0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .blog-posts {
    padding: 4rem 0;
    background: #f5f5f5;
    min-height: 50vh;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .no-posts {
    text-align: center;
    color: #666;
    font-style: italic;
  }
</style>
