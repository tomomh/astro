---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortableText from '../../components/PortableText.astro';
import { client, queries, urlFor } from '../../lib/sanity';

export async function getStaticPaths() {
  const posts = await client.fetch(`*[_type == "post"]{ slug }`);

  return posts.map((post: any) => ({
    params: { slug: post.slug.current },
  }));
}

const { slug } = Astro.params;
const post = await client.fetch(queries.postBySlug, { slug });

if (!post) {
  return Astro.redirect('/404');
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<BaseLayout title={`${post.title} | Blog`} description={post.excerpt}>
  <article class="post">
    <header class="post-header">
      <div class="container">
        {post.categories && post.categories.length > 0 && (
          <div class="categories">
            {post.categories.map((category: string) => (
              <span class="category">{category}</span>
            ))}
          </div>
        )}
        <h1>{post.title}</h1>
        <div class="meta">
          {post.author?.name && (
            <div class="author">
              {post.author.image && (
                <img
                  src={urlFor(post.author.image).width(40).height(40).url()}
                  alt={post.author.name}
                  class="author-image"
                />
              )}
              <span>By {post.author.name}</span>
            </div>
          )}
          {formattedDate && (
            <time datetime={post.publishedAt}>{formattedDate}</time>
          )}
        </div>
      </div>
    </header>

    {post.mainImage && (
      <div class="featured-image">
        <img
          src={urlFor(post.mainImage).width(1200).height(600).url()}
          alt={post.title}
        />
      </div>
    )}

    <div class="post-content">
      <div class="container">
        {post.body && (
          <PortableText value={post.body} class="body-content" />
        )}
      </div>
    </div>

    <footer class="post-footer">
      <div class="container">
        <a href={`${base}/blog`} class="back-link">&larr; Back to Blog</a>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    background: #1a1a2e;
    color: #fff;
    padding: 4rem 0;
    text-align: center;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .categories {
    margin-bottom: 1rem;
  }

  .category {
    display: inline-block;
    background: #64b5f6;
    color: #1a1a2e;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    margin: 0 0.25rem;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  .meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    color: #e0e0e0;
  }

  .author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .author-image {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .featured-image {
    max-width: 1000px;
    margin: -2rem auto 0;
    padding: 0 1rem;
  }

  .featured-image img {
    width: 100%;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }

  .post-content {
    padding: 3rem 0;
  }

  .post-footer {
    padding: 2rem 0;
    border-top: 1px solid #eee;
  }

  .back-link {
    color: #1a1a2e;
    text-decoration: none;
    font-weight: 500;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
