---
import { urlFor } from '../lib/sanity';

interface Props {
  post: {
    title: string;
    slug: { current: string };
    excerpt?: string;
    publishedAt?: string;
    mainImage?: any;
    author?: string;
  };
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;

const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<article class="post-card">
  {post.mainImage && (
    <a href={`${base}blog/${post.slug.current}`} class="image-link">
      <img
        src={urlFor(post.mainImage).width(600).height(400).url()}
        alt={post.title}
        loading="lazy"
      />
    </a>
  )}
  <div class="content">
    <h2>
      <a href={`${base}blog/${post.slug.current}`}>{post.title}</a>
    </h2>
    {post.excerpt && <p class="excerpt">{post.excerpt}</p>}
    <div class="meta">
      {post.author && <span class="author">By {post.author}</span>}
      {formattedDate && <time datetime={post.publishedAt}>{formattedDate}</time>}
    </div>
  </div>
</article>

<style>
  .post-card {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .image-link {
    display: block;
  }

  img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .content {
    padding: 1.5rem;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
  }

  h2 a {
    color: #1a1a2e;
    text-decoration: none;
  }

  h2 a:hover {
    color: #4a4a6a;
  }

  .excerpt {
    color: #666;
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .meta {
    display: flex;
    gap: 1rem;
    font-size: 0.75rem;
    color: #888;
  }
</style>
