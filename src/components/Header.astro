---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { href: `${base}/`, label: 'Home' },
  { href: `${base}/blog`, label: 'Blog (Sanity)' },
  { href: `${base}/posts`, label: 'Posts (MD/MDX)' },
];
---

<header class="header">
  <div class="container">
    <a href={base} class="logo">
      <span>Astro + Sanity</span>
    </a>
    <nav>
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    background: #1a1a2e;
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    color: #fff;
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: bold;
  }

  .nav-list {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: #e0e0e0;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: #fff;
  }
</style>
