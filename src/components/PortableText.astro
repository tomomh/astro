---
/**
 * PortableText.astro - Server-side Portable Text renderer for Astro
 *
 * Renders Sanity's Portable Text content without client-side JavaScript.
 * Supports: headings, paragraphs, lists, links, marks (bold, italic, code, etc.)
 * Features: Syntax highlighting with Shiki (built into Astro)
 *
 * Usage:
 * <PortableText value={post.body} />
 */

import { codeToHtml } from 'shiki';
import {
  type PortableTextContent,
  type PortableTextBlock,
  type PortableTextImage,
  type PortableTextCode,
  renderBlock,
  groupBlocks,
  escapeHtml,
} from '../lib/portableText';
import { urlFor } from '../lib/sanity';

interface Props {
  value: PortableTextContent[];
  class?: string;
}

const { value, class: className } = Astro.props;

if (!value || !Array.isArray(value)) {
  return null;
}

// Separate blocks and custom types
const blocks: PortableTextBlock[] = [];
const customTypes: Map<number, PortableTextContent> = new Map();

value.forEach((item, index) => {
  if (item._type === 'block') {
    blocks.push(item as PortableTextBlock);
  } else {
    customTypes.set(index, item);
  }
});

// Group blocks for proper list rendering
const groupedBlocks = groupBlocks(blocks);

// Pre-process code blocks with Shiki for syntax highlighting
const codeBlocksHtml = new Map<string, string>();

for (const [, item] of customTypes) {
  if (item._type === 'code') {
    const codeItem = item as PortableTextCode;
    const language = codeItem.language || 'text';

    try {
      const highlighted = await codeToHtml(codeItem.code, {
        lang: language,
        theme: 'dracula',
      });
      codeBlocksHtml.set(codeItem._key, highlighted);
    } catch {
      // Fallback to non-highlighted code if language not supported
      codeBlocksHtml.set(codeItem._key, `<pre><code>${escapeHtml(codeItem.code)}</code></pre>`);
    }
  }
}

// Render grouped content
function renderGroupedContent(): string {
  let html = '';
  let blockIndex = 0;

  for (const group of groupedBlocks) {
    // Check for custom types that should appear before this block
    while (customTypes.has(blockIndex)) {
      const customType = customTypes.get(blockIndex)!;
      html += renderCustomType(customType);
      blockIndex++;
    }

    if (group.type === 'list') {
      const tag = group.listType === 'number' ? 'ol' : 'ul';
      const items = group.items.map((item) => renderBlock(item)).join('\n');
      html += `<${tag}>\n${items}\n</${tag}>`;
      blockIndex += group.items.length;
    } else {
      html += renderBlock(group.block);
      blockIndex++;
    }
  }

  // Render any remaining custom types
  while (customTypes.has(blockIndex)) {
    const customType = customTypes.get(blockIndex)!;
    html += renderCustomType(customType);
    blockIndex++;
  }

  return html;
}

function renderCustomType(item: PortableTextContent): string {
  switch (item._type) {
    case 'image': {
      const img = item as PortableTextImage;
      const imageUrl = urlFor(img.asset).width(800).url();
      const alt = escapeHtml(img.alt || '');
      const caption = img.caption ? escapeHtml(img.caption) : '';

      return `
        <figure class="portable-text-image">
          <img src="${imageUrl}" alt="${alt}" loading="lazy" />
          ${caption ? `<figcaption>${caption}</figcaption>` : ''}
        </figure>
      `;
    }
    case 'code': {
      const code = item as PortableTextCode;
      const filename = code.filename ? escapeHtml(code.filename) : '';
      const highlightedCode = codeBlocksHtml.get(code._key) || `<pre><code>${escapeHtml(code.code)}</code></pre>`;

      return `
        <div class="portable-text-code">
          ${filename ? `<div class="code-filename">${filename}</div>` : ''}
          ${highlightedCode}
        </div>
      `;
    }
    default:
      return `<!-- Unknown type: ${(item as any)._type} -->`;
  }
}

const content = renderGroupedContent();
---

<div class:list={['portable-text', className]} set:html={content} />

<style is:global>
  .portable-text {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #333;
  }

  .portable-text h1,
  .portable-text h2,
  .portable-text h3,
  .portable-text h4,
  .portable-text h5,
  .portable-text h6 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #1a1a2e;
    line-height: 1.3;
  }

  .portable-text h1 { font-size: 2rem; }
  .portable-text h2 { font-size: 1.5rem; }
  .portable-text h3 { font-size: 1.25rem; }
  .portable-text h4 { font-size: 1.125rem; }

  .portable-text p {
    margin-bottom: 1.5rem;
  }

  .portable-text ul,
  .portable-text ol {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
  }

  .portable-text li {
    margin-bottom: 0.5rem;
  }

  .portable-text a {
    color: #1565c0;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .portable-text a:hover {
    color: #0d47a1;
  }

  .portable-text strong {
    font-weight: 600;
  }

  .portable-text em {
    font-style: italic;
  }

  .portable-text code {
    background: #f5f5f5;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.875em;
    font-family: 'Fira Code', 'Monaco', 'Consolas', monospace;
  }

  .portable-text blockquote {
    border-left: 4px solid #64b5f6;
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: #666;
    font-style: italic;
  }

  .portable-text-image {
    margin: 2rem 0;
  }

  .portable-text-image img {
    width: 100%;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .portable-text-image figcaption {
    text-align: center;
    color: #666;
    font-size: 0.875rem;
    margin-top: 0.5rem;
    font-style: italic;
  }

  .portable-text-code {
    margin: 1.5rem 0;
  }

  .portable-text-code .code-filename {
    background: #1e1e3f;
    color: #e0e0e0;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    border-radius: 8px 8px 0 0;
    font-family: 'Fira Code', monospace;
  }

  .portable-text-code pre {
    background: #282a36;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 0;
  }

  .portable-text-code .code-filename + pre {
    border-radius: 0 0 8px 8px;
  }

  .portable-text-code pre code {
    background: none;
    padding: 0;
    color: #f8f8f2;
    font-size: 0.875rem;
  }

  /* Shiki code block overrides */
  .portable-text-code .shiki {
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 0;
  }

  .portable-text-code .code-filename + .shiki {
    border-radius: 0 0 8px 8px;
  }

  .portable-text-code .shiki code {
    background: none;
    padding: 0;
    font-size: 0.875rem;
    font-family: 'Fira Code', 'Monaco', 'Consolas', monospace;
  }
</style>
